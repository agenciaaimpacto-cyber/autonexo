# Carpeta madre de fotos originales de autos — vive solo en este Mac.
# El sitio usa las copias optimizadas generadas en assets/autos/, que sí
# se suben al repo. Ver scripts/generar_vitrina.py y vehiculos/_LEEME.txt.
# Nota: con "/" al inicio para que NO matchee assets/vendidos/ ni ninguna
# otra carpeta con este nombre en otro nivel — sin la barra, git ignora
# cualquier carpeta llamada así en cualquier profundidad (pasó el 28 de
# septiembre de 2026: assets/vendidos/ quedaba ignorada por error).
/vehiculos/

# Portadas de autos vendidos (prueba social) — original sin optimizar, vive
# solo en esta Mac. El sitio usa las copias en assets/vendidos/. Ver
# vendidos/_LEEME.txt.
/vendidos/

# Volcado original de fotos/logo/portada (WhatsApp/Facebook/ChatGPT) desde
# el que se arma vehiculos/ y los assets de marca. Ya cumplió su función
# como fuente de datos/fotos — se mantiene local por si hace falta revisar
# algo, pero no debe subirse al repo (son archivos pesados sin optimizar).
# Antes se llamaba "Autodirecto/" (borrada por Danny el 11 de septiembre de
# 2026 al cambiar de marca); ahora es "AutoNexo/".
AutoNexo/
Autodirecto/

# Imagen original de portada del home (sin optimizar) — reemplazada el 11 de
# septiembre por AutoNexo/Portada.png. Ya no se usa, se deja por si acaso.
negocio autos.png

.DS_Store

# Videos de referencia (logo animado, etc.) — pesados, no se necesitan en el
# repo. El sitio usa activos ya optimizados (imágenes/CSS), no el video en sí.
*.mp4
